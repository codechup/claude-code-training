#!/usr/bin/env sh
# Two guards. Install once per clone/worktree:
#   git config core.hooksPath scripts/git-hooks
# (or run scripts/install-hooks.sh)
#
#   1. direct pushes to main are refused (main is PR-only);
#   2. no commit may leave this machine carrying a personal identity, a session URL, or a private
#      pattern in its metadata or message (.claude/rules/public-hygiene.md).
#
# The scan is driven by the refs on STDIN, one range per pushed ref — NOT by HEAD. Pushing a
# second worktree's branch, `git push --all`, and `git push origin <sha>:refs/heads/x` are all
# normal daily usage here, and every one of them can push commits that are not on HEAD.
root=$(git rev-parse --show-toplevel) || exit 0
zero=$(printf '%040d' 0)
checked=0
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "pre-push: direct pushes to 'main' are not allowed. Open a PR from a plan/NN-slug branch (see plans/README.md)." >&2
      exit 1;;
  esac

  # A ref deletion pushes nothing; there is no commit to scan.
  case "$local_sha" in "$zero"|"") continue;; esac

  if [ "$remote_sha" = "$zero" ] || [ -z "$remote_sha" ]; then
    # New branch on the remote: everything reachable from it that no origin ref already has.
    set -- "$local_sha" --not --remotes=origin
  else
    set -- "$remote_sha..$local_sha"
  fi
  checked=1
  node "$root/scripts/check-public-hygiene.mjs" --commits "$@" || fail=1
done

# Fallback: git gave us no refs on stdin (some invocations do not). Scan the current branch.
if [ "$checked" -eq 0 ]; then
  if range=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) && [ -n "$range" ]; then
    range="$range..HEAD"
  elif git rev-parse --verify --quiet origin/main >/dev/null; then
    range="origin/main..HEAD"
  else
    range="HEAD" # no upstream and no origin/main yet: scan everything rather than skip
  fi
  node "$root/scripts/check-public-hygiene.mjs" --commits "$range" || fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: refusing to push — see .claude/rules/public-hygiene.md ('Commit identity')." >&2
  echo "Fix the identity, then rewrite the offending commits:" >&2
  echo "  git config user.name codechup && git config user.email <id>+codechup@users.noreply.github.com" >&2
  echo "  git rebase --exec 'git commit --amend --no-edit --reset-author' <base>" >&2
  exit 1
fi
exit 0
