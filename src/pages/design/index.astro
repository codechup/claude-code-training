    font-size: var(--cc-text-micro);
    font-weight: var(--cc-weight-micro);
    letter-spacing: var(--cc-track-micro);
    text-transform: uppercase;
  }

  .k-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--cc-space-3);
    min-width: 0;
  }

  .k-figure__note {
    margin: 0;
  }

  /* Inside a panel the note follows a specimen, so it needs the air that a
     figure's own flex gap would otherwise give it. */
  .k-panel > .k-figure__note {
    margin-block-start: var(--cc-space-5);
  }

  /* The caret is a terminal glyph; on paper it needs its terminal ground to
     be visible at all. */
  .k-caretbox {
    display: inline-flex;
    align-items: center;
    padding-inline: var(--cc-space-1);
    background: var(--cc-term-bg);
    border-radius: var(--cc-radius-sm);
    vertical-align: -0.2em;
  }

  .k-row {
    display: flex;
    align-items: center;
    gap: var(--cc-space-6);
  }

  .k-row--baseline {
    align-items: flex-end;
    flex-wrap: wrap;
  }

  .k-row--wrap {
    flex-wrap: wrap;
    gap: var(--cc-space-4);
  }

  .k-stack {
    display: flex;
    flex-direction: column;
    gap: var(--cc-space-4);
    align-items: stretch;
    min-width: 0;
  }

  /* For specimens that must keep their intrinsic width — a lockup is not a
     full-bleed block and stretching it would misrepresent it. */
  .k-stack--start {
    align-items: flex-start;
  }

  .k-stack--tight {
    gap: var(--cc-space-2);
  }

  .k-strong {
    color: var(--cc-ink);
    font-weight: 600;
  }

  /* -- principles ------------------------------------------------------ */
  .k-principles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--cc-line);
  }

  @media (min-width: 720px) {
    .k-principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--cc-space-8);
    }
  }

