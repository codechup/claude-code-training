<style>
  /* =====================================================================
     `/design` page chrome. Documentation furniture only — every component
     specimen styles itself. Tokens only; no literal colour, size or motion
     value is written here.
     ===================================================================== */

  /* AA over the token name. KILN §3.3 sets an eyebrow in `--cc-ink-faint`,
     but that value measures ~3.6:1 on paper and axe flags every instance
     (the same conclusion `Lockup.astro` reached for its publisher line).
     Eyebrows on this page are text, so they take `--cc-ink-muted`, which
     clears 4.5:1 in both themes. `--cc-ink-faint` stays for non-text use.
     The global `.eyebrow` in app.css still ships the faint value — see this
     plan's Handoff notes; this override is scoped to `/design` only. */
  .eyebrow {
    color: var(--cc-ink-muted);
  }

  .k-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cc-space-8);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .k-shell {
      grid-template-columns: 190px minmax(0, 1fr);
      gap: var(--cc-space-10);
    }
  }

  /* -- local nav -------------------------------------------------------
     Phone: a sticky, horizontally scrolling strip under the header.
     Desktop: a sticky column beside the content. */
  .k-nav {
    position: sticky;
    top: var(--cc-header-h);
    z-index: 2;
    /* Full-bleed on a phone: the gutter moves onto the scrolling list so the
       first and last link can reach the screen edges instead of being cut
       off behind a padded box. */
    margin-inline: calc(var(--cc-gutter) * -1);
    background: var(--cc-paper);
    border-block-end: 1px solid var(--cc-line);
  }

  .k-nav__title {
    display: none;
  }

  /* The strip already scrolled, but nothing on screen said so: eight section
     links run to ~962px inside a 390px viewport and the last four simply
     stopped at the edge. The two-gradient scroll shadow (the terminal's, KILN
     §8.1) marks each side that can still be scrolled — the `local` covers
     travel with the content and cancel the `scroll` shades at the ends. */
  .k-nav__list {
    display: flex;
    gap: var(--cc-space-4);
    margin: 0;
    padding-inline: var(--cc-gutter);
    padding-block: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scroll-padding-inline: var(--cc-gutter);
    background-image:
      linear-gradient(to right, var(--cc-paper) 55%, transparent),
      linear-gradient(to left, var(--cc-paper) 55%, transparent),
      linear-gradient(to right, var(--cc-line-strong), transparent),
      linear-gradient(to left, var(--cc-line-strong), transparent);
    background-position:
      left center,
      right center,
      left center,
      right center;
    background-size:
      40px 100%,
      40px 100%,
      18px 100%,
      18px 100%;
    background-repeat: no-repeat;
    background-attachment: local, local, scroll, scroll;
  }

  .k-nav__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--cc-tap);
    /* A one-word section name ("Type", "Icons") was only 33–39px wide in the
       scrolling strip; 44 in both axes (KILN §4). */
    min-width: var(--cc-tap);
    white-space: nowrap;
    font-size: var(--cc-text-small);
    color: var(--cc-ink-muted);
    text-decoration: none;
    border-block-end: 2px solid transparent;
  }

  .k-nav__link:hover {
    color: var(--cc-ink);
  }

  .k-nav__link[aria-current='true'] {
    color: var(--cc-accent);
    border-block-end-color: var(--cc-accent);
  }

  @media (min-width: 1024px) {
    .k-nav {
      top: calc(var(--cc-header-h) + var(--cc-space-6));
      margin-inline: 0;
      background: none;
      border-block-end: 0;
    }

    .k-nav__title {
      display: flex;
      margin: 0 0 var(--cc-space-3);
    }

    .k-nav__list {
      flex-direction: column;
      gap: 0;
      padding-inline: 0;
      overflow: visible;
      background-image: none;
      border-inline-start: 1px solid var(--cc-line);
    }

    .k-nav__link {
      justify-content: flex-start;
      min-height: var(--cc-tap);
      padding-inline-start: var(--cc-space-4);
      margin-inline-start: -1px;
      border-block-end: 0;
      border-inline-start: 2px solid transparent;
    }

    .k-nav__link[aria-current='true'] {
      border-inline-start-color: var(--cc-accent);
    }
  }

  /* -- rhythm ---------------------------------------------------------- */
  .k-main {
    display: flex;
    flex-direction: column;
    gap: var(--cc-space-11);
    min-width: 0;
  }

  .k-hero {
    display: flex;
    flex-direction: column;
    gap: var(--cc-space-4);
    padding-block-end: var(--cc-space-8);
    border-block-end: 1px solid var(--cc-line);
  }

