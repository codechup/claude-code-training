    display: flex;
    flex-direction: column;
    gap: var(--cc-space-3);
  }

  .k-sec__head p {
    margin: 0;
  }

  .k-group {
    display: flex;
    flex-direction: column;
    gap: var(--cc-space-4);
    min-width: 0;
  }

  .k-group__title {
    margin: 0;
    padding-block-end: var(--cc-space-2);
    border-block-end: 1px solid var(--cc-line);
    color: var(--cc-ink-muted);
    font-size: var(--cc-text-small);
    font-weight: var(--cc-weight-micro);
    letter-spacing: var(--cc-track-micro);
    text-transform: uppercase;
  }

  .k-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cc-space-6);
    align-items: start;
  }

  @media (min-width: 860px) {
    .k-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* -- panels ---------------------------------------------------------- */
  .k-panel {
    padding: var(--cc-space-6);
    background: var(--cc-paper-raised);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-lg);
