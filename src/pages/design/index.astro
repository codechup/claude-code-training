<style>
  .card {
    background: var(--color-bg-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border: 1px solid transparent;
  }

  h2 {
    font-size: var(--text-24);
  }
</style>

<script>
  // Reads every token value LIVE from computed style — this is what keeps
  // the dump (and the contrast matrix) from ever drifting away from
  // tokens.css. Re-runs whenever `data-theme` changes (the toggle) or the
  // OS preference changes while "system" is selected, so the numbers on
  // screen always match whichever theme is actually showing.
  function parseColor(raw: string): [number, number, number] | null {
    const value = raw.trim();
    // 6-digit hex (#rrggbb).
    const hex6 = value.match(/^#([0-9a-f]{6})$/i);
    if (hex6) {
      const n = parseInt(hex6[1], 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    // 3-digit shorthand hex (#rgb) — the CSS minifier shortens six-digit values
    // (e.g. pure white) to the three-digit form in the compiled stylesheet, so getComputedStyle can return
    // either form depending on the token's actual value.
    const hex3 = value.match(/^#([0-9a-f])([0-9a-f])([0-9a-f])$/i);
    if (hex3) {
      return [
        parseInt(hex3[1] + hex3[1], 16),
        parseInt(hex3[2] + hex3[2], 16),
        parseInt(hex3[3] + hex3[3], 16),
      ];
    }
    const rgb = value.match(/rgba?\(([^)]+)\)/i);
    if (rgb) {
      const parts = rgb[1].split(',').map((p) => parseFloat(p));
      if (parts.length >= 3) return [parts[0], parts[1], parts[2]];
    }
    return null;
  }

  function relLuminance([r, g, b]: [number, number, number]): number {
    const [R, G, B] = [r, g, b].map((v) => {
      const s = v / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * R + 0.7152 * G + 0.0722 * B;
  }

  function contrastRatio(a: [number, number, number], b: [number, number, number]): number {
    const [l1, l2] = [relLuminance(a), relLuminance(b)].sort((p, q) => q - p);
    return (l1 + 0.05) / (l2 + 0.05);
  }

  function refresh() {
    const styles = getComputedStyle(document.documentElement);

    document.querySelectorAll<HTMLElement>('[data-token-value]').forEach((el) => {
      const name = el.dataset.tokenValue;
      if (!name) return;
      el.textContent = styles.getPropertyValue(name).trim() || '—';
    });

    document.querySelectorAll<HTMLTableRowElement>('[data-contrast-row]').forEach((row) => {
      const fgVar = row.dataset.fg;
      const bgVar = row.dataset.bg;
      const ratioCell = row.querySelector<HTMLElement>('[data-contrast-ratio]');
      const resultCell = row.querySelector<HTMLElement>('[data-contrast-result]');
      const dot = row.querySelector<HTMLElement>('[data-contrast-dot]');
      if (!fgVar || !bgVar || !ratioCell || !resultCell || !dot) return;

      const fg = parseColor(styles.getPropertyValue(fgVar));
      const bg = parseColor(styles.getPropertyValue(bgVar));
      if (!fg || !bg) {
        ratioCell.textContent = '—';
        resultCell.textContent = 'unknown';
        dot.style.background = 'var(--color-ink-muted)';
        return;
      }

      // The result is always readable as TEXT in `--color-ink` (verified
      // AA pass against bg-0/bg-2 in both themes) — the dot is a
      // decorative, non-text reinforcement only, not the only way the
      // pass/fail state is conveyed (axe: color-contrast, WCAG 1.4.1).
      const ratio = contrastRatio(fg, bg);
      ratioCell.textContent = `${ratio.toFixed(1)}:1`;
      resultCell.textContent = ratio >= 4.5 ? 'AA pass' : ratio >= 3 ? 'AA large only' : 'fail';
      dot.style.background =
        ratio >= 4.5
          ? 'var(--color-success)'
          : ratio >= 3
            ? 'var(--color-warning)'
            : 'var(--color-danger)';
    });
  }

  refresh();

  // The toggle sets data-theme synchronously on click; a MutationObserver
  // catches that (and any other future writer of the same attribute).
  new MutationObserver(refresh).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });

  // Also catch a live OS-preference change while "system" is selected —
  // theme-init.js/ThemeToggle already update data-theme in that case, but
  // this covers the fallback no-JS-attribute state too.
  window.matchMedia?.('(prefers-color-scheme: dark)').addEventListener?.('change', refresh);
</script>
