</style>

<script>
  /*
   * Three jobs, all read-only against the DOM this page already rendered:
   *
   *  1. fill every `[data-token-value]` with the token's LIVE computed value;
   *  2. compute every contrast row from those same live values;
   *  3. mark the local-nav link for the section currently on screen.
   *
   * (1) and (2) are what keep this page from drifting out of sync with
   * tokens.css: no colour is ever typed into the page source, so a token edit
   * shows up here on the next reload without anyone remembering to update a
   * table. Both re-run on a theme change.
   *
   * Astro bundles this into an external module — there is no inline script
   * body (CSP `script-src 'self'`).
   */
  type RGB = [number, number, number];

  function parseColor(raw: string): RGB | null {
    const value = raw.trim();
    const hex6 = value.match(/^#([0-9a-f]{6})$/i);
    if (hex6) {
      const n = parseInt(hex6[1], 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    // The CSS minifier shortens six-digit values to three digits, so a token
    // can come back either way depending on its value.
    const hex3 = value.match(/^#([0-9a-f])([0-9a-f])([0-9a-f])$/i);
    if (hex3) {
      return [
        parseInt(hex3[1] + hex3[1], 16),
        parseInt(hex3[2] + hex3[2], 16),
        parseInt(hex3[3] + hex3[3], 16),
      ];
    }
    const fn = value.match(/rgba?\(([^)]+)\)/i);
    if (fn) {
      const parts = fn[1].split(/[ ,/]+/).map((p) => parseFloat(p));
      if (parts.length >= 3) return [parts[0], parts[1], parts[2]];
    }
    return null;
  }

  function relLuminance([r, g, b]: RGB): number {
    const [R, G, B] = [r, g, b].map((v) => {
      const s = v / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * R + 0.7152 * G + 0.0722 * B;
  }

  function contrastRatio(a: RGB, b: RGB): number {
    const [l1, l2] = [relLuminance(a), relLuminance(b)].sort((p, q) => q - p);
    return (l1 + 0.05) / (l2 + 0.05);
  }

  function refresh(): void {
    const styles = getComputedStyle(document.documentElement);

    document.querySelectorAll<HTMLElement>('[data-token-value]').forEach((el) => {
      const name = el.dataset.tokenValue;
      if (!name) return;
      el.textContent = styles.getPropertyValue(name).trim() || '—';
    });

    document.querySelectorAll<HTMLElement>('[data-contrast-row]').forEach((row) => {
      const fgVar = row.dataset.fg;
      const bgVar = row.dataset.bg;
      const ratioCell = row.querySelector<HTMLElement>('[data-contrast-ratio]');
      const resultCell = row.querySelector<HTMLElement>('[data-contrast-result]');
      const icon = row.querySelector<HTMLElement>('[data-contrast-icon]');
      if (!fgVar || !bgVar || !ratioCell || !resultCell || !icon) return;

      const fg = parseColor(styles.getPropertyValue(fgVar));
      const bg = parseColor(styles.getPropertyValue(bgVar));
      if (!fg || !bg) {
        ratioCell.textContent = '—';
        resultCell.textContent = 'unknown';
        icon.textContent = '?';
        return;
      }

      // The verdict is always readable as words in the page's own ink; the
      // glyph beside it is a second, non-colour signal (WCAG 1.4.1).
      const ratio = contrastRatio(fg, bg);
      ratioCell.textContent = `${ratio.toFixed(2)}:1`;
      if (ratio >= 7) {
        resultCell.textContent = 'AAA';
        icon.textContent = '✓';
      } else if (ratio >= 4.5) {
        resultCell.textContent = 'AA';
        icon.textContent = '✓';
      } else if (ratio >= 3) {
        resultCell.textContent = 'AA large / UI only';
        icon.textContent = '~';
      } else {
        resultCell.textContent = 'below AA';
        icon.textContent = '✗';
      }
    });
  }

  refresh();

  // The theme control writes `data-theme` synchronously; catch that, and an
  // OS-level change while "system" is selected.
  new MutationObserver(refresh).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  window.matchMedia?.('(prefers-color-scheme: dark)').addEventListener?.('change', refresh);

  // -- local nav: mark the section currently in view ----------------------
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
    const id = a.dataset.navLink;
    if (id) links.set(id, a);
  });

  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0) {
    const list = document.querySelector<HTMLElement>('.k-nav__list');
    let current = '';
    const setCurrent = (id: string) => {
      if (id === current) return;
      current = id;
      links.forEach((a, key) => {
        if (key === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });

      // On phones the nav is a horizontal strip, so the current item can sit
      // off-screen. Nudge the strip itself — never `scrollIntoView`, which
      // would also scroll the page out from under the reader.
      const active = links.get(id);
      if (!list || !active || list.scrollWidth <= list.clientWidth) return;
      const left = active.offsetLeft - (list.clientWidth - active.offsetWidth) / 2;
      list.scrollTo({ left: Math.max(0, left), behavior: 'auto' });
    };

    const onScroll = () => {
      // The "current" section is the last one whose top has passed the
      // reading line, a third of the way down the viewport.
      const line = window.innerHeight / 3;
      let found = sections[0].id;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= line) found = section.id;
      }
      setCurrent(found);
    };

    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        onScroll();
      });
    };

    onScroll();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  }
</script>
