    padding-block: var(--cc-space-4);
    border-block-end: 1px solid var(--cc-line);
  }

  .k-principle__n {
    color: var(--cc-accent);
    font-size: var(--cc-text-micro);
  }

  .k-principle__title,
  .k-principle__body {
    margin: 0;
    grid-column: 2;
  }

  .k-principle__title {
    font-weight: 600;
  }

  /* -- brand ----------------------------------------------------------- */
  .k-mono-mark {
    display: inline-flex;
    color: var(--cc-ink);
  }

  .k-mono-mark--accent {
    color: var(--cc-accent);
