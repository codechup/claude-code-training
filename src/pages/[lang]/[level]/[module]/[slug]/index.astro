---
// The lesson page (`/[lang]/[level]/[module]/[slug]/`), composed exactly as
// `docs/design/canvas-out/Lesson1280.dc.html` draws it: meta header, MDX
// body, Sources, helpful/edit row, prev/next + module progress; sidebar tree
// and "On this page" rail come from the Lesson layout.
//
// Draft lessons get no route at all (D015 parity is a FILE-level rule, not a
// page-level one): `getStaticPaths` filters them, so a `draft: true` TR twin
// simply has no page until its translation wave lands, and `LangSwitch`
// renders "Türkçesi hazırlanıyor" instead of linking into a 404.
import type { InferGetStaticParamsType } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import LessonLayout from '../../../../../layouts/Lesson.astro';
import LessonMeta from '../../../../../components/lesson/LessonMeta.astro';
import PrevNext from '../../../../../components/lesson/PrevNext.astro';
import ProgressBar from '../../../../../components/lesson/ProgressBar.astro';
import Callout from '../../../../../components/mdx/Callout.astro';
import CodeBlock from '../../../../../components/mdx/CodeBlock.astro';
import DecisionTree from '../../../../../components/mdx/DecisionTree.astro';
import Giscus from '../../../../../components/mdx/Giscus.astro';
import Helpful from '../../../../../components/mdx/Helpful.astro';
import Lab from '../../../../../components/mdx/Lab.astro';
import OSTabs from '../../../../../components/mdx/OSTabs.astro';
import Quiz from '../../../../../components/mdx/Quiz.astro';
import Sources from '../../../../../components/mdx/Sources.astro';
import Transcript from '../../../../../components/mdx/Transcript.astro';
import WhenNotToUse from '../../../../../components/mdx/WhenNotToUse.astro';
import YouTubeCard from '../../../../../components/mdx/YouTubeCard.astro';
import { buildNav, lessonNeighbours } from '../../../../../lib/nav.ts';
import { t } from '../../../../../lib/i18n/ui.ts';
import { editUrl } from '../../../../../lib/repo.ts';
import { levelBadgeStyle } from '../../../../../lib/levels.ts';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => !data.draft);
  return lessons.map((entry) => {
    const [lang, level, module, slug] = entry.id.split('/');
    return { params: { lang, level, module, slug }, props: { entry } };
  });
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { lang, level, module, slug } = Astro.params as Params;
const { entry } = Astro.props as { entry: CollectionEntry<'lessons'> };

const sections = await getCollection('sections');
const allLessons = await getCollection('lessons');
const tree = buildNav(lang, sections, allLessons);
const neighbours = lessonNeighbours(tree, entry.id);

const strings = t(lang);
const path = `/${lang}/${level}/${module}/${slug}/`;

// The sibling-language lesson only counts as "available" when it exists AND
// is not a draft — this is the build-time draft set LangSwitch consumes.
const other = lang === 'en' ? 'tr' : 'en';
const twin = allLessons.find((l) => l.id === `${other}/${level}/${module}/${slug}`);
const altPath = twin && !twin.data.draft ? `/${other}/${level}/${module}/${slug}/` : null;

const { Content, headings } = await render(entry);

// The MDX component vocabulary (P07 + P08), registered as the default set
// for every lesson body so a lesson writes `<Callout>` / `<Lab>` / `<Quiz>`
// without a per-file import block (P07's Handoff notes asked for exactly
// this). Astro's MDX integration takes the map through `<Content
// components={…} />`; a lesson may still import a component explicitly to
// override one of these.
const mdxComponents = {
  Callout,
  CodeBlock,
  DecisionTree,
  Giscus,
  Helpful,
  Lab,
  OSTabs,
  Quiz,
  Sources,
  Transcript,
  WhenNotToUse,
  YouTubeCard,
};

const isPlaceholder = entry.data.tags.includes('placeholder');
const levelNumber = neighbours?.level.number ?? entry.data.level;
const editHref = editUrl(entry.filePath ?? `content/${entry.id}.mdx`);
---

<LessonLayout
  lang={lang}
  title={`${entry.data.title} — ${strings.siteName}`}
  description={entry.data.description}
  path={path}
  altPath={altPath}
  tree={tree}
  activeLevel={level}
  activeModule={module}
  activeLessonId={entry.id}
  headings={headings}
  crumbs={[
    {
      label: levelNumber ? `L${levelNumber}` : (neighbours?.level.title ?? level),
      href: `/${lang}/${level}/`,
    },
    {
      label: `${neighbours?.module.shortId ?? module} ${neighbours?.module.title ?? ''}`.trim(),
      href: `/${lang}/${level}/${module}/`,
    },
    { label: entry.data.title },
  ]}
>
  {
    isPlaceholder && (
      <aside class="cc-placeholder" role="note">
        <span class="mono cc-placeholder-badge" style={levelBadgeStyle(null)}>
          {strings.placeholderBadge}
        </span>
        <p>{strings.placeholderNote}</p>
      </aside>
    )
  }

  <LessonMeta
    lang={lang}
    title={entry.data.title}
    level={levelNumber}
    moduleShortId={neighbours?.module.shortId ?? module}
    moduleTitle={neighbours?.module.title ?? ''}
    position={neighbours?.position ?? 1}
    moduleTotal={neighbours?.moduleTotal ?? 1}
    durationMin={entry.data.duration_min}
    difficulty={entry.data.difficulty}
    tags={entry.data.tags}
    updated={entry.data.updated}
    verifiedVersion={entry.data.verified_version}
  />

  {/* The MDX body, with P07/P08's component vocabulary registered above. */}
  <article class="cc-body">
    <Content components={mdxComponents} />
  </article>

  {/* Sources block (D041), rendered by P07's component from the frontmatter. */}
  {entry.data.sources.length > 0 && <Sources sources={entry.data.sources} lang={lang} />}

  <div class="cc-footer-row">
    <Helpful lessonId={entry.id} lang={lang} />
    <a class="mono muted cc-edit" href={editHref}>{strings.editOnGitHub}</a>
  </div>

  <Giscus lang={lang} />

  <hr />

  <PrevNext lang={lang} prev={neighbours?.prev ?? null} next={neighbours?.next ?? null} />

  <ProgressBar
    lang={lang}
    ids={(neighbours?.module.lessons ?? []).map((l) => l.id)}
    labelMode="count"
    moduleId={neighbours?.module.shortId ?? module}
    lessonId={entry.id}
    level={levelNumber}
  />
</LessonLayout>

<style>
  .cc-placeholder {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 14px 16px;
    margin-bottom: var(--space-5);
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-3);
    background: var(--color-bg-1);
  }

  .cc-placeholder p {
    margin: 0;
    font-size: var(--text-14);
    color: var(--color-ink-soft);
  }

  .cc-placeholder-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: var(--radius-1);
    font-size: var(--text-11);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cc-body {
    margin: var(--space-6) 0;
  }

  .cc-body :global(h2) {
    margin-top: var(--space-8);
    font-size: var(--text-24);
  }

  .cc-body :global(h3) {
    margin-top: var(--space-6);
  }

  .cc-body :global(p),
  .cc-body :global(ul),
  .cc-body :global(ol) {
    margin: var(--space-4) 0;
  }

  .cc-body :global(a) {
    color: var(--color-accent-text);
  }

  .cc-body :global(pre) {
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
    background: var(--color-bg-1);
    overflow-x: auto;
  }

  .cc-body :global(code) {
    font-family: var(--font-family-mono);
    font-size: var(--text-14);
  }

  .cc-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    font-size: var(--text-14);
  }

  .cc-edit {
    font-size: var(--text-12);
    color: var(--color-ink-muted);
  }

  hr {
    margin: var(--space-5) 0;
  }
</style>
