</style>

<script>
  // The level cards' progress rings. Progress lives only in `localStorage`
  // (D020: no accounts), so the server renders the empty state and this
  // hoisted module — bundled by Astro into an external file, so the CSP's
  // `script-src 'self'` is satisfied — fills it in. `src/lib/progress.ts`
  // owns the storage contract; nothing about it is re-implemented here.
  import { completedCount } from '../../lib/progress.ts';

  const RING_C = 2 * Math.PI * 26;

  for (const ring of document.querySelectorAll<HTMLElement>('[data-cc-ring]')) {
    let ids: string[] = [];
    try {
      const parsed: unknown = JSON.parse(ring.dataset.ids ?? '[]');
      if (Array.isArray(parsed)) ids = parsed.filter((v): v is string => typeof v === 'string');
    } catch {
      ids = [];
    }

    const total = ids.length;
    const done = completedCount(ring.dataset.lang ?? 'en', ids);
    const pct = total > 0 ? Math.round((done / total) * 100) : 0;

    const fill = ring.querySelector<SVGCircleElement>('.cc-ring__fill');
    if (fill) fill.style.strokeDashoffset = String(RING_C * (1 - pct / 100));

    const label = ring.querySelector<HTMLElement>('[data-cc-ring-pct]');
    if (label) label.textContent = `${pct}%`;

    // The words beside the ring are the accessible signal; the ring itself
    // is decorative (KILN §10: never state by colour alone).
    const count = ring.closest('li')?.querySelector<HTMLElement>('[data-cc-ring-count]');
    if (count) {
      count.textContent = (count.dataset.template ?? '{done}').replace('{done}', String(done));
    }
  }
</script>
