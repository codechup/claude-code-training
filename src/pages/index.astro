---
// `/` — locale dispatch (D017).
//
// In production nginx owns this path and 302s on the `cc_lang` cookie /
// Accept-Language before Astro is ever consulted (see docs/deploy). This
// page is the fallback for everywhere that doesn't happen: `astro preview`,
// a CDN edge miss, or the file opened directly.
//
// Two mechanisms, in order of trust:
//   1. `<meta http-equiv="refresh">` to `/en/` — works with JavaScript off.
//   2. A hoisted (bundled, external — CSP-clean) script that runs first and
//      prefers the `cc_lang` cookie, then a `tr`-prefixed `navigator.language`.
// The refresh delay is 1s so the script always wins when scripting is on.
//
// It is on-brand rather than bare because it IS visible: a second of Kiln —
// paper, the mark, and the two doors out — beats a second of unstyled
// Times New Roman for anyone whose JavaScript is off.
import '../styles/app.css';
import Lockup from '../components/brand/Lockup.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="1; url=/en/" />
    <title>CodeChup Claude Code Academy</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://cc.codechup.com/en/" />
    <link rel="alternate" hreflang="en" href="https://cc.codechup.com/en/" />
    <link rel="alternate" hreflang="tr" href="https://cc.codechup.com/tr/" />
    <link rel="alternate" hreflang="x-default" href="https://cc.codechup.com/en/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <main class="cc-dispatch">
      <Lockup lang="en" size="lg" publisher />
      <h1 class="cc-dispatch__title">
        Choose a language <span lang="tr">— Bir dil seç</span>
      </h1>
      <p class="cc-dispatch__lead soft">
        You are being sent to the English site; pick the other door if you would rather read
        <span lang="tr"> Türkçe</span>.
      </p>
      <div class="cc-dispatch__links">
        <a class="cc-dispatch__btn" href="/en/">English</a>
        <a class="cc-dispatch__btn" href="/tr/" lang="tr">Türkçe</a>
      </div>
    </main>

    <script>
      // Cookie first (the reader's own LangSwitch choice), then the browser's
      // language list. Anything else falls through to the meta refresh.
      function preferred(): string {
        try {
          const cookie = document.cookie
            .split(';')
            .map((part) => part.trim())
            .find((part) => part.startsWith('cc_lang='));
          const stored = cookie?.slice('cc_lang='.length);
          if (stored === 'en' || stored === 'tr') return stored;
        } catch {
          // Cookie access can throw under strict privacy settings.
        }
        const languages = navigator.languages ?? [navigator.language];
        for (const tag of languages) {
          if (typeof tag === 'string' && tag.toLowerCase().startsWith('tr')) return 'tr';
        }
        return 'en';
      }

      window.location.replace(`/${preferred()}/`);
    </script>
  </body>
</html>

<style>
  .cc-dispatch {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cc-space-4);
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    padding: var(--cc-space-12) var(--cc-space-6);
  }

  .cc-dispatch__title {
    margin: var(--cc-space-6) 0 0;
    max-width: 20ch;
  }

  .cc-dispatch__title span {
    color: var(--cc-ink-muted);
  }

  .cc-dispatch__lead {
    margin: 0;
  }

  .cc-dispatch__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cc-space-3);
    margin-block-start: var(--cc-space-2);
  }

  .cc-dispatch__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--cc-tap);
    padding-inline: var(--cc-space-6);
    border: 1px solid var(--cc-line-strong);
    border-radius: var(--cc-radius-md);
    background: var(--cc-paper-raised);
    color: var(--cc-ink);
    font-weight: 550;
    text-decoration: none;
  }

  .cc-dispatch__btn:first-child {
    background: var(--cc-accent);
    border-color: var(--cc-accent);
    color: var(--cc-on-accent);
  }

  .cc-dispatch__btn:first-child:hover {
    background: var(--cc-accent-hover);
    color: var(--cc-on-accent);
  }
</style>
