---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Not found / Bulunamadı" description="Page not found." lang="en" path="/404/">
  <main class="mx-auto flex max-w-2xl flex-col gap-6 px-4 py-16 text-center">
    <div>
      <h1 class="font-mono text-4xl font-bold">404</h1>
      <p class="mt-2">This page doesn't exist.</p>
      <p><a class="text-link underline" href="/en/">Back to the English site</a></p>
    </div>
    <hr class="border-border" />
    <div lang="tr">
      <h2 class="font-mono text-2xl font-bold">404</h2>
      <p class="mt-2">Bu sayfa bulunamadı.</p>
      <p><a class="text-link underline" href="/tr/">Türkçe siteye dön</a></p>
    </div>
  </main>
</Base>
