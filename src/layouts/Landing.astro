---
// The locale landing page shell (`/[lang]/`).
//
// KILN §7.1: landing pages are a stack of FULL-BLEED bands. The layout
// therefore imposes no width at all — a band spans the viewport and is
// responsible for centring its own `.cc-container` inside itself, so a
// band can carry a tinted ground edge to edge without the shell fighting
// it with a max-width and a horizontal padding it did not ask for.
import Base from './Base.astro';
import Header from '../components/shell/Header.astro';
import Footer from '../components/shell/Footer.astro';
import SkipLink from '../components/shell/SkipLink.astro';
import { alternatesFor } from '../lib/seo.ts';
import Sidebar from '../components/lesson/Sidebar.astro';
import { getCollection } from 'astro:content';
import { buildNav } from '../lib/nav.ts';

interface Props {
  lang: string;
  title: string;
  description: string;
  path: string;
  altPath?: string | null;
}

const { lang, title, description, path, altPath } = Astro.props;

// The mobile drawer carries the same curriculum tree on every route (KILN
// §7.2) — see the note in Section.astro.
const [allSections, allLessons] = await Promise.all([
  getCollection('sections'),
  getCollection('lessons'),
]);
const tree = buildNav(lang, allSections, allLessons);
---

<Base
  title={title}
  description={description}
  lang={lang}
  path={path}
  alternates={alternatesFor(lang, path, altPath)}
  bodyClass="cc-page-landing"
>
  <SkipLink lang={lang} />
  <Header lang={lang} altPath={altPath}>
    <Sidebar slot="drawer-tree" lang={lang} tree={tree} />
  </Header>
  <main id="main" class="cc-landing" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .cc-landing {
    display: flow-root;
    width: 100%;
  }

  /*
   * Band rhythm (KILN §4: 80px between major sections) is published as a
   * default a band can read, NOT imposed as padding — the landing page owns
   * its own bands and a layout-level `padding-block` here would silently
   * outrank the page's own shorthand.
   */
  .cc-landing {
    --cc-band-py: var(--cc-space-11);
  }

  @media (min-width: 1024px) {
    .cc-landing {
      --cc-band-py: var(--cc-space-12);
    }
  }
</style>
