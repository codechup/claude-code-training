---
// The locale landing page shell (`/[lang]/`): header, full-bleed sections,
// footer. Section order and gutters follow `docs/design/canvas-out/
// Main.dc.html` (1280) and `Landing390.dc.html` (390).
import Base from './Base.astro';
import Header from '../components/shell/Header.astro';
import Footer from '../components/shell/Footer.astro';
import { t } from '../lib/i18n/ui.ts';
import { alternatesFor } from '../lib/seo.ts';

interface Props {
  lang: string;
  title: string;
  description: string;
  path: string;
  altPath?: string | null;
}

const { lang, title, description, path, altPath } = Astro.props;
const strings = t(lang);
---

<Base
  title={title}
  description={description}
  lang={lang}
  path={path}
  alternates={alternatesFor(lang, path, altPath)}
>
  <a class="cc-skip" href="#main">{strings.skipToContent}</a>
  <Header lang={lang} altPath={altPath} />
  <main id="main" class="cc-landing" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .cc-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-2);
    color: var(--color-ink);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-2);
  }

  .cc-skip:focus {
    left: var(--space-4);
    top: var(--space-2);
  }
</style>

<style>
  .cc-landing {
    display: flex;
    flex-direction: column;
  }
</style>
