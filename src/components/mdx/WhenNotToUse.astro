---
// The D006/D090 "When NOT to use" lesson-template section: a literal
// `Callout` preset (`variant="when-not-to-use"`, warning border) so lesson
// authors don't have to remember the variant name for a section every
// lesson has exactly once.
import Callout from './Callout.astro';

interface Props {
  /** Defaults to the exact copy shown in `Lesson1280.dc.html`. */
  label?: string;
}

const { label = 'When not to use this' } = Astro.props as Props;
---

<Callout variant="when-not-to-use" label={label}>
  <slot />
</Callout>
