---
/**
 * Quiz — KILN §8.6.
 *
 * One card per question: the prompt at h3 scale, answers as full-width
 * pills at least `--cc-tap` (44 px) tall. Choosing turns the correct answer
 * `--cc-ok-wash` with a check and, when wrong, the chosen answer
 * `--cc-danger-wash` with an x, revealing the explanation. The verdict is
 * announced through an `aria-live="polite"` status line, and a reset link
 * clears the question. State per lesson lives in
 * `localStorage['cc:quiz:<lessonId>']` (D064, D020 — no accounts).
 *
 * The prompt is a real `<legend>` over a `<fieldset>` of native
 * `<input type="radio">`s: full keyboard support and a properly grouped,
 * labelled control without a hand-rolled ARIA widget. It is styled at h3
 * scale rather than being an `<h3>`, so a page of quizzes does not inject a
 * heading level into the lesson outline.
 *
 * No inline script body (CSP): the behaviour below is a hoisted module.
 */
import Icon from '../ui/Icon.astro';

export interface QuizOption {
  text: string;
  correct?: boolean;
  /** One-line reveal shown once this option (or the correct one) is highlighted. */
  explanation?: string;
}

interface Props {
  lessonId: string;
  questionId: string;
  lang?: string;
  prompt?: string;
  options: QuizOption[];
}

const { lessonId, questionId, lang = 'en', prompt, options } = Astro.props;

if (options.length < 2) {
  throw new Error(`Quiz "${questionId}": at least two options are required.`);
}

let correctIndex = options.findIndex((o) => o.correct);
if (correctIndex === -1) {
  // Defensive default so the page still renders and works during authoring;
  // this is a content bug, not a runtime one, so it only warns at build time.
  console.warn(`Quiz "${questionId}": no option marked correct — defaulting to option 0.`);
  correctIndex = 0;
}

const groupName = `cc-quiz-${lessonId}-${questionId}`.replace(/[^a-zA-Z0-9_-]/g, '-');

const strings =
  lang === 'tr'
    ? {
        eyebrow: 'Kendini sına',
        correct: 'Doğru.',
        incorrect: 'Doğru değil — doğru cevap işaretlendi.',
        reset: 'Sıfırla',
      }
    : {
        eyebrow: 'Check yourself',
        correct: 'Correct.',
        incorrect: 'Not quite — the correct answer is highlighted.',
        reset: 'Reset',
      };
---

<div
  class="cc-quiz"
  data-cc-quiz
  data-lesson-id={lessonId}
  data-question-id={questionId}
  data-correct-index={correctIndex}
  data-label-correct={strings.correct}
  data-label-incorrect={strings.incorrect}
>
  <p class="cc-quiz__eyebrow"><Icon name="quiz" size={16} /><span>{strings.eyebrow}</span></p>

  <fieldset class="cc-quiz__set">
    <legend class="cc-quiz__prompt">{prompt ?? <slot />}</legend>
    <div class="cc-quiz__options">
      {
        options.map((opt, i) => (
          <label class="cc-quiz__option" data-cc-quiz-option>
            <input
              class="cc-quiz__radio"
              type="radio"
              name={groupName}
              value={i}
              data-cc-quiz-input
            />
            <span class="cc-quiz__dot" aria-hidden="true">
              <span class="cc-quiz__dot-mark cc-quiz__dot-mark--ok">
                <Icon name="check" size={14} />
              </span>
              <span class="cc-quiz__dot-mark cc-quiz__dot-mark--no">
                <Icon name="close" size={14} />
              </span>
            </span>
            <span class="cc-quiz__text">{opt.text}</span>
            {opt.explanation && (
              <span class="cc-quiz__why" data-cc-quiz-explanation hidden>
                {opt.explanation}
              </span>
            )}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="cc-quiz__foot">
    <p class="cc-quiz__status" data-cc-quiz-status aria-live="polite"></p>
    <button class="cc-quiz__reset" type="button" data-cc-quiz-reset hidden>{strings.reset}</button>
  </div>
</div>

<style>
  .cc-quiz {
    margin: var(--cc-space-9) 0;
    max-width: var(--cc-measure);
    padding: var(--cc-space-6);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-lg);
    background: var(--cc-paper-raised);
  }

  .cc-quiz__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--cc-space-2);
    margin: 0 0 var(--cc-space-3);
    max-width: none;
    color: var(--cc-ink-muted);
    font-size: var(--cc-text-micro);
    font-weight: var(--cc-weight-micro);
    letter-spacing: var(--cc-track-micro);
    line-height: 1;
    text-transform: uppercase;
  }

  .cc-quiz__set {
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Styled at h3 scale, not an <h3>: a lesson's outline stays the author's. */
  .cc-quiz__prompt {
    padding: 0;
    margin-bottom: var(--cc-space-4);
    font-family: var(--cc-font-sans);
    font-size: var(--cc-text-h3);
    font-weight: var(--cc-weight-h3);
    line-height: var(--cc-leading-h3);
    letter-spacing: var(--cc-track-h3);
    color: var(--cc-ink);
  }

  .cc-quiz__options {
    display: flex;
    flex-direction: column;
    gap: var(--cc-space-2);
  }

  .cc-quiz__option {
    position: relative;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    align-items: center;
    column-gap: var(--cc-space-3);
    row-gap: var(--cc-space-2);
    min-height: var(--cc-tap);
    padding: var(--cc-space-3) var(--cc-space-5);
    border: 1px solid var(--cc-line);
    /* KILN §8.6 asks for pill answers, but a pill only works while the row
       is one line: once an answer wraps at 390px, or grows to ~140px with
       its explanation, the pill turns into a stadium capsule whose ends are
       pure curve — a silhouette nothing else on the site has. `--cc-radius-lg`
       holds at every height and matches the card idiom in §8.9. */
    border-radius: var(--cc-radius-lg);
    background: var(--cc-paper);
    cursor: pointer;
  }

  .cc-quiz__option:hover {
    border-color: var(--cc-line-strong);
    background: var(--cc-paper-sunken);
  }

  /* The real radio is kept (native keyboard + grouping) and visually
     replaced by `.cc-quiz__dot`, which the focus ring follows. It fills the
     whole answer row: the row was always the hit area (it is a `<label>`),
     but the control measured 22×22 and read as a sub-44px target. Absolute
     positioning takes it out of the grid — the dot keeps cell 1/1, the text
     1/2 — while leaving it the dot's previous sibling for `:checked` and
     `:focus-visible`. */
  .cc-quiz__radio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .cc-quiz__dot {
    grid-area: 1 / 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 2px solid var(--cc-line-strong);
    border-radius: var(--cc-radius-pill);
    background: var(--cc-paper-raised);
    pointer-events: none;
  }

  .cc-quiz__radio:checked + .cc-quiz__dot {
    border-color: var(--cc-accent);
    box-shadow: inset 0 0 0 4px var(--cc-paper-raised);
    background: var(--cc-accent);
  }

  .cc-quiz__radio:focus-visible + .cc-quiz__dot {
    outline: var(--cc-focus-width) solid var(--cc-focus-color);
    outline-offset: var(--cc-focus-offset);
  }

  .cc-quiz__dot-mark {
    display: none;
    align-items: center;
    justify-content: center;
  }

  .cc-quiz__text {
    grid-column: 2;
    /* An answer can carry an env-var name longer than a 390px column
       (CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE); without this it ran off
       the card edge instead of breaking. */
    overflow-wrap: anywhere;
    font-size: var(--cc-text-body);
    line-height: var(--cc-leading-body);
    color: var(--cc-ink);
  }

  .cc-quiz__why {
    grid-column: 2;
    overflow-wrap: anywhere;
    font-size: var(--cc-text-small);
    line-height: var(--cc-leading-small);
    color: var(--cc-ink-muted);
  }

  /* -- answered states. Never colour alone: the disc swaps to a check or an
     x, and the explanation spells the verdict out. --------------------- */
  .cc-quiz__option.is-correct {
    border-color: var(--cc-ok-line);
    background: var(--cc-ok-wash);
  }

  .cc-quiz__option.is-correct .cc-quiz__dot,
  .cc-quiz__option.is-correct .cc-quiz__radio:checked + .cc-quiz__dot {
    border-color: var(--cc-ok);
    background: var(--cc-ok);
    box-shadow: none;
    color: var(--cc-paper-raised);
  }

  .cc-quiz__option.is-correct .cc-quiz__dot-mark--ok {
    display: flex;
  }

  .cc-quiz__option.is-wrong {
    border-color: var(--cc-danger-line);
    background: var(--cc-danger-wash);
  }

  .cc-quiz__option.is-wrong .cc-quiz__dot,
  .cc-quiz__option.is-wrong .cc-quiz__radio:checked + .cc-quiz__dot {
    border-color: var(--cc-danger);
    background: var(--cc-danger);
    box-shadow: none;
    color: var(--cc-paper-raised);
  }

  .cc-quiz__option.is-wrong .cc-quiz__dot-mark--no {
    display: flex;
  }

  /* -- foot ------------------------------------------------------------- */
  .cc-quiz__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cc-space-4);
    min-height: var(--cc-tap);
    margin-top: var(--cc-space-3);
  }

  .cc-quiz__status {
    margin: 0;
    max-width: none;
    font-size: var(--cc-text-small);
    line-height: var(--cc-leading-small);
    color: var(--cc-ink-muted);
  }

  .cc-quiz__reset {
    display: inline-flex;
    align-items: center;
    min-height: var(--cc-tap);
    padding: 0 var(--cc-space-4);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-pill);
    background: transparent;
    color: var(--cc-ink-muted);
    font-family: inherit;
    font-size: var(--cc-text-small);
    cursor: pointer;
  }

  .cc-quiz__reset:hover {
    border-color: var(--cc-accent-line);
    color: var(--cc-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cc-quiz__option,
    .cc-quiz__dot,
    .cc-quiz__reset {
      transition:
        background var(--cc-dur-fast) var(--cc-ease),
        border-color var(--cc-dur-fast) var(--cc-ease),
        color var(--cc-dur-fast) var(--cc-ease);
    }
  }
</style>

<script>
  import { readQuiz, writeQuiz, type QuizState } from '../../lib/progress.ts';

  function cssEscape(value: string): string {
    return typeof CSS !== 'undefined' && CSS.escape
      ? CSS.escape(value)
      : value.replace(/"/g, '\\"');
  }

  function clearFeedback(root: HTMLElement): void {
    for (const opt of root.querySelectorAll<HTMLElement>('[data-cc-quiz-option]')) {
      opt.classList.remove('is-correct', 'is-wrong');
      const explanation = opt.querySelector<HTMLElement>('[data-cc-quiz-explanation]');
      if (explanation) explanation.hidden = true;
    }
    const status = root.querySelector<HTMLElement>('[data-cc-quiz-status]');
    if (status) status.textContent = '';
    root.querySelector<HTMLElement>('[data-cc-quiz-reset]')?.setAttribute('hidden', '');
  }

  function applyFeedback(root: HTMLElement, chosenIndex: number): void {
    const correctIndex = Number(root.dataset.correctIndex ?? '0');
    const options = root.querySelectorAll<HTMLElement>('[data-cc-quiz-option]');
    options.forEach((opt, i) => {
      opt.classList.remove('is-correct', 'is-wrong');
      const explanation = opt.querySelector<HTMLElement>('[data-cc-quiz-explanation]');
      const reveal = i === chosenIndex || i === correctIndex;
      if (explanation) explanation.hidden = !reveal;
      if (i === correctIndex) opt.classList.add('is-correct');
      else if (i === chosenIndex) opt.classList.add('is-wrong');
    });

    const status = root.querySelector<HTMLElement>('[data-cc-quiz-status]');
    if (status) {
      status.textContent =
        chosenIndex === correctIndex
          ? (root.dataset.labelCorrect ?? '')
          : (root.dataset.labelIncorrect ?? '');
    }
    root.querySelector<HTMLElement>('[data-cc-quiz-reset]')?.removeAttribute('hidden');
  }

  function recomputeScoreTotal(lessonId: string, state: QuizState): void {
    const widgets = document.querySelectorAll<HTMLElement>(
      `[data-cc-quiz][data-lesson-id="${cssEscape(lessonId)}"]`,
    );
    let score = 0;
    let total = 0;
    widgets.forEach((widget) => {
      const qid = widget.dataset.questionId;
      if (!qid || !(qid in state.answers)) return;
      total += 1;
      if (state.answers[qid] === Number(widget.dataset.correctIndex ?? '-1')) score += 1;
    });
    state.score = score;
    state.total = total;
  }

  function persist(root: HTMLElement, chosenIndex: number | null): void {
    const lessonId = root.dataset.lessonId ?? '';
    const questionId = root.dataset.questionId ?? '';
    if (!lessonId || !questionId) return;
    const state: QuizState = readQuiz(lessonId) ?? { answers: {}, score: 0, total: 0 };
    if (chosenIndex === null) delete state.answers[questionId];
    else state.answers[questionId] = chosenIndex;
    recomputeScoreTotal(lessonId, state);
    writeQuiz(lessonId, state);
  }

  function hydrate(root: HTMLElement): void {
    const lessonId = root.dataset.lessonId ?? '';
    const questionId = root.dataset.questionId ?? '';
    const state = readQuiz(lessonId);
    const chosen = state?.answers[questionId];
    if (chosen === undefined) return;
    const inputs = root.querySelectorAll<HTMLInputElement>('[data-cc-quiz-input]');
    const input = inputs[chosen];
    if (input) input.checked = true;
    applyFeedback(root, chosen);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-cc-quiz]')) {
    hydrate(root);
    const inputs = root.querySelectorAll<HTMLInputElement>('[data-cc-quiz-input]');
    inputs.forEach((input, i) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        applyFeedback(root, i);
        persist(root, i);
      });
    });

    root.querySelector<HTMLButtonElement>('[data-cc-quiz-reset]')?.addEventListener('click', () => {
      for (const input of inputs) input.checked = false;
      clearFeedback(root);
      persist(root, null);
      inputs[0]?.focus();
    });
  }
</script>
