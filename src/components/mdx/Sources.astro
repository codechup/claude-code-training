---
/**
 * Sources — KILN §8.7.
 *
 * A compact list, not a card grid: one hairline-separated row per source,
 * carrying a type chip, the title as a link with an `arrow-up-right`, the
 * host in `small` `--cc-ink-faint`, and the verified date right-aligned.
 * Video rows add channel and duration (D042: a link, never an embedded
 * player). The official-docs source is marked with a filled chip (D041).
 */
import type { Source } from '../../content/schema.ts';
import { hostOf, verifiedDate, videoMeta } from './sources.ts';
import { t } from '../../lib/i18n/ui.ts';
import Icon from '../ui/Icon.astro';

interface Props {
  sources: Source[];
  lang: string;
}

const { sources, lang } = Astro.props as Props;
const strings = t(lang);

const TYPE_LABEL: Record<string, Record<Source['type'], string>> = {
  en: { official: 'official', video: 'video', article: 'article', repo: 'repo' },
  tr: { official: 'resmî', video: 'video', article: 'makale', repo: 'depo' },
};
const typeLabel = TYPE_LABEL[lang] ?? TYPE_LABEL.en;
---

<section class="cc-sources" aria-labelledby="cc-sources-heading">
  <h2 class="cc-sources__heading" id="cc-sources-heading">{strings.sources}</h2>
  <ul class="cc-sources__list">
    {
      sources.map((source) => {
        const meta = source.type === 'video' ? videoMeta(source) : null;
        return (
          <li class="cc-sources__row">
            <span class={`cc-sources__chip cc-sources__chip--${source.type}`}>
              {typeLabel[source.type]}
            </span>
            <span class="cc-sources__main">
              <a
                class="cc-sources__link"
                href={source.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="cc-sources__head">
                  <span class="cc-sources__title">{source.title}</span>
                  <span class="cc-sources__out">
                    <Icon name="arrow-up-right" size={15} />
                  </span>
                </span>
                <span class="cc-sources__detail">
                  {hostOf(source.url)}
                  {meta ? ` · ${meta}` : ''}
                </span>
              </a>
            </span>
            <span class="cc-sources__date">
              <span class="cc-sources__date-label">{strings.verifiedOn}</span>{' '}
              <time datetime={verifiedDate(source)}>{verifiedDate(source)}</time>
            </span>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .cc-sources {
    margin-top: var(--cc-space-9);
    max-width: var(--cc-measure);
  }

  .cc-sources__heading {
    margin: 0 0 var(--cc-space-4);
    font-size: var(--cc-text-h2);
    letter-spacing: var(--cc-track-h2);
  }

  .cc-sources__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--cc-line);
  }

  .cc-sources__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: var(--cc-space-3);
    row-gap: var(--cc-space-1);
    padding: var(--cc-space-3) 0;
    border-bottom: 1px solid var(--cc-line);
  }

  /* Type chip — a shape, not a colour: `official` is the only one that
     takes the accent, because it is the one D041 makes mandatory. */
  .cc-sources__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.5rem;
    height: 22px;
    margin-top: 3px;
    padding: 0 var(--cc-space-2);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-pill);
    background: var(--cc-paper-sunken);
    color: var(--cc-ink-muted);
    font-size: var(--cc-text-micro);
    font-weight: var(--cc-weight-micro);
    letter-spacing: var(--cc-track-micro);
    text-transform: uppercase;
  }

  .cc-sources__chip--official {
    background: var(--cc-accent-wash);
    border-color: var(--cc-accent-line);
    /* 12px clay on the accent wash is 4.11:1 with `--cc-accent`. */
    color: var(--cc-accent-text);
  }

  .cc-sources__main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  /* The host line lives INSIDE the anchor: the whole title+host block is
     one target, at least `--cc-tap` tall, and it reads as one thing to a
     screen reader ("Quickstart, code.claude.com") rather than as a link
     followed by an orphan fragment. */
  .cc-sources__link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: var(--cc-tap);
    padding: var(--cc-space-1) 0;
    color: var(--cc-ink);
    text-decoration: none;
    font-size: var(--cc-text-body);
    line-height: 1.45;
  }

  .cc-sources__head {
    display: inline-flex;
    align-items: baseline;
    gap: var(--cc-space-2);
  }

  .cc-sources__title {
    text-decoration: underline;
    text-decoration-color: var(--cc-line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .cc-sources__link:hover .cc-sources__title,
  .cc-sources__link:focus-visible .cc-sources__title {
    color: var(--cc-accent);
    text-decoration-color: var(--cc-accent);
  }

  .cc-sources__out {
    display: inline-flex;
    color: var(--cc-ink-faint);
  }

  .cc-sources__link:hover .cc-sources__out {
    color: var(--cc-accent);
  }

  .cc-sources__detail {
    font-size: var(--cc-text-small);
    line-height: var(--cc-leading-small);
    letter-spacing: var(--cc-track-small);
    color: var(--cc-ink-muted);
  }

  .cc-sources__date {
    grid-column: 2;
    font-size: var(--cc-text-small);
    line-height: var(--cc-leading-small);
    color: var(--cc-ink-muted);
    white-space: nowrap;
  }

  .cc-sources__date-label {
    text-transform: lowercase;
  }

  /* From the 3-column layout's prose width up, the date returns to its own
     right-aligned column and the row becomes a single line of hierarchy. */
  @media (min-width: 640px) {
    .cc-sources__row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      padding: var(--cc-space-3) 0;
    }

    .cc-sources__chip {
      margin-top: 0;
    }

    .cc-sources__date {
      grid-column: 3;
      justify-self: end;
      text-align: right;
    }
  }
</style>
