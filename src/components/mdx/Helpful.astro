---
/**
 * "Was this helpful?" (D067/D069), restyled to the Kiln card idiom (§8.9).
 *
 * Posts `{ lessonId, lang, vote }` to the same-origin `/api/feedback` route
 * served (once deployed — owner action O8) by the Worker under `worker/**`.
 * Until then the origin has no such route and the POST 404s — an *expected*
 * state, not a bug: on any non-2xx or network error the buttons are replaced
 * by a templated GitHub Issues link, with no console error and no stuck
 * spinner. One vote per lesson is remembered in
 * `localStorage['cc:helpful:<lessonId>']`.
 *
 * The vote buttons use the shared icon set (KILN §6) — a check and an x,
 * with the verdict also written on the button, so the answer is never
 * carried by shape alone.
 */
import { REPO_URL } from '../../lib/repo.ts';
import Icon from '../ui/Icon.astro';

interface Props {
  lessonId: string;
  lang?: string;
}

const { lessonId, lang = 'en' } = Astro.props;

const strings = {
  question: lang === 'tr' ? 'Bu sayfa yardımcı oldu mu?' : 'Was this helpful?',
  yes: lang === 'tr' ? 'Evet' : 'Yes',
  no: lang === 'tr' ? 'Hayır' : 'No',
  yesLabel: lang === 'tr' ? 'Evet, yardımcı oldu' : 'Yes, this was helpful',
  noLabel: lang === 'tr' ? 'Hayır, yardımcı olmadı' : 'No, this was not helpful',
  thanks: lang === 'tr' ? 'Geri bildiriminiz için teşekkürler.' : 'Thanks for the feedback.',
  fallback: lang === 'tr' ? "GitHub'da bize bildirin" : 'Tell us on GitHub',
};

function githubFeedbackUrl(): string {
  const title = encodeURIComponent(`Feedback: ${lessonId}`);
  const body = encodeURIComponent(
    `Lesson: ${lessonId}\nLanguage: ${lang}\n\nWhat did you find confusing, wrong, or missing?`,
  );
  return `${REPO_URL}/issues/new?title=${title}&body=${body}&labels=feedback`;
}

const fallbackHref = githubFeedbackUrl();
---

<div class="cc-helpful" data-cc-helpful data-lesson-id={lessonId} data-lang={lang}>
  <p class="cc-helpful__q">{strings.question}</p>
  <div class="cc-helpful__actions" data-cc-helpful-buttons>
    <button
      type="button"
      class="cc-helpful__btn"
      data-cc-helpful-vote="up"
      aria-label={strings.yesLabel}
    >
      <Icon name="check-circle" size={16} /><span>{strings.yes}</span>
    </button>
    <button
      type="button"
      class="cc-helpful__btn"
      data-cc-helpful-vote="down"
      aria-label={strings.noLabel}
    >
      <Icon name="x-circle" size={16} /><span>{strings.no}</span>
    </button>
  </div>
  <p class="cc-helpful__thanks" data-cc-helpful-thanks hidden>
    <Icon name="check-circle" size={16} /><span>{strings.thanks}</span>
  </p>
  <a class="cc-helpful__fallback" data-cc-helpful-fallback href={fallbackHref} hidden>
    <Icon name="github" size={16} /><span>{strings.fallback}</span>
  </a>
</div>

<style>
  .cc-helpful {
    flex: 1 1 20rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--cc-space-3) var(--cc-space-4);
    padding: var(--cc-space-4) var(--cc-space-5);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-lg);
    background: var(--cc-paper-raised);
  }

  .cc-helpful__q {
    margin: 0;
    max-width: none;
    font-size: var(--cc-text-small);
    line-height: var(--cc-leading-small);
    color: var(--cc-ink-muted);
  }

  .cc-helpful__actions {
    display: inline-flex;
    gap: var(--cc-space-2);
    margin-left: auto;
  }

  .cc-helpful__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--cc-space-2);
    min-height: var(--cc-tap);
    min-width: var(--cc-tap);
    padding: 0 var(--cc-space-4);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-pill);
    background: var(--cc-paper);
    color: var(--cc-ink-muted);
    font-family: inherit;
    font-size: var(--cc-text-small);
    cursor: pointer;
  }

  .cc-helpful__btn:hover {
    border-color: var(--cc-accent-line);
    background: var(--cc-accent-wash);
    color: var(--cc-accent);
  }

  .cc-helpful__btn:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .cc-helpful__thanks,
  .cc-helpful__fallback {
    display: inline-flex;
    align-items: center;
    gap: var(--cc-space-2);
    margin: 0 0 0 auto;
    max-width: none;
    min-height: var(--cc-tap);
    font-size: var(--cc-text-small);
  }

  .cc-helpful__thanks {
    color: var(--cc-ok);
  }

  .cc-helpful__fallback {
    color: var(--cc-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cc-helpful__btn {
      transition:
        background var(--cc-dur-fast) var(--cc-ease),
        border-color var(--cc-dur-fast) var(--cc-ease),
        color var(--cc-dur-fast) var(--cc-ease);
    }
  }
</style>

<script>
  const VOTES = new Set(['up', 'down']);

  function safeGet(key: string): string | null {
    try {
      return window.localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function safeSet(key: string, value: string): void {
    try {
      window.localStorage.setItem(key, value);
    } catch {
      // Private browsing / disabled storage: the vote still posts, it just
      // won't be remembered as "already voted" on the next visit.
    }
  }

  function showThanks(root: HTMLElement): void {
    root.querySelector<HTMLElement>('[data-cc-helpful-buttons]')?.setAttribute('hidden', '');
    root.querySelector<HTMLElement>('[data-cc-helpful-thanks]')?.removeAttribute('hidden');
    root.querySelector<HTMLElement>('[data-cc-helpful-fallback]')?.setAttribute('hidden', '');
  }

  function showFallback(root: HTMLElement): void {
    root.querySelector<HTMLElement>('[data-cc-helpful-buttons]')?.setAttribute('hidden', '');
    root.querySelector<HTMLElement>('[data-cc-helpful-thanks]')?.setAttribute('hidden', '');
    root.querySelector<HTMLElement>('[data-cc-helpful-fallback]')?.removeAttribute('hidden');
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-cc-helpful]')) {
    const lessonId = root.dataset.lessonId ?? '';
    const lang = root.dataset.lang ?? 'en';
    const storeKey = `cc:helpful:${lessonId}`;

    const existing = safeGet(storeKey);
    if (existing && VOTES.has(existing)) {
      showThanks(root);
      continue;
    }

    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-cc-helpful-vote]');
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const vote = button.dataset.ccHelpfulVote;
        if (!vote || !VOTES.has(vote)) return;

        for (const b of buttons) b.disabled = true;

        fetch('/api/feedback', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ lessonId, lang, vote }),
        })
          .then((res) => {
            if (!res.ok) throw new Error(`feedback endpoint responded ${res.status}`);
            safeSet(storeKey, vote);
            showThanks(root);
          })
          .catch(() => {
            // Network error, or a non-2xx (the expected 404 before the
            // Worker is deployed) — never a console error the visitor
            // notices, never a stuck disabled button: fall back to the
            // GitHub link.
            showFallback(root);
          });
      });
    }
  }
</script>
