---
// YouTube sources are always link cards, never embedded players (D042) —
// this component renders no <iframe> and loads no player script, ever.
//
// Thumbnail note: this is a fully static site (`output: 'static'` in
// astro.config.ts). Astro's `<Image>`/`astro:assets` would fetch each
// remote `i.ytimg.com` thumbnail over the network at BUILD time to
// optimise it locally — fragile in a sandboxed/offline CI build and it
// would re-fetch on every build for every YouTube source in the whole
// site. A plain `<img>` instead loads the thumbnail directly from
// YouTube's own CDN in the visitor's browser (which already serves a
// pre-optimised JPEG), with ordinary lazy-loading and explicit
// width/height to avoid layout shift — no build-time network dependency.
// `astro.config.ts`'s `image.domains: ['i.ytimg.com']` allow-list is left
// in place for the day a future plan wants build-time optimisation.
interface Props {
  videoId: string;
  title: string;
  channel: string;
  /** e.g. "12:04". */
  duration: string;
  lang?: string;
  /** Override the default `hqdefault.jpg` thumbnail if a specific still is nicer. */
  thumbnailUrl?: string;
}

import Icon from '../ui/Icon.astro';

const { videoId, title, channel, duration, lang = 'en', thumbnailUrl } = Astro.props;

const href = `https://www.youtube.com/watch?v=${encodeURIComponent(videoId)}`;
const thumbnail =
  thumbnailUrl ?? `https://i.ytimg.com/vi/${encodeURIComponent(videoId)}/hqdefault.jpg`;

const watchLabel =
  lang === 'tr' ? "YouTube'da izle (yeni sekmede açılır)" : 'Watch on YouTube (opens in a new tab)';
const videoChip = lang === 'tr' ? 'video' : 'video';
---

<a
  class="cc-yt"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${watchLabel}: ${title}`}
>
  <img
    class="cc-yt-thumb"
    src={thumbnail}
    alt=""
    width="320"
    height="180"
    loading="lazy"
    decoding="async"
  />
  <span class="cc-yt-body">
    <span class="cc-yt-chip">{videoChip}</span>
    <span class="cc-yt-title">{title}</span>
    <span class="cc-yt-meta">{channel} · {duration}</span>
  </span>
  <span class="cc-yt-external">
    <Icon name="arrow-up-right" size={16} />
  </span>
</a>

<style>
  /* Card idiom (KILN §8.9): raised paper, hairline, `--cc-radius-lg`, and a
     hover that raises to `--cc-shadow-1` and moves the accent underline of
     the title. Never an embedded player (D042). */
  .cc-yt {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--cc-space-4);
    margin: var(--cc-space-6) 0;
    max-width: var(--cc-measure);
    min-height: var(--cc-tap);
    padding: var(--cc-space-3);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-lg);
    background: var(--cc-paper-raised);
    color: var(--cc-ink);
    text-decoration: none;
  }

  .cc-yt:hover {
    border-color: var(--cc-line-strong);
    box-shadow: var(--cc-shadow-1);
  }

  .cc-yt-thumb {
    width: 128px;
    height: 72px;
    border-radius: var(--cc-radius-md);
    object-fit: cover;
    background: var(--cc-paper-sunken);
  }

  .cc-yt-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cc-space-1);
    min-width: 0;
  }

  .cc-yt-chip {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 var(--cc-space-2);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-pill);
    background: var(--cc-paper-sunken);
    color: var(--cc-ink-muted);
    font-family: var(--cc-font-sans);
    font-size: var(--cc-text-micro);
    font-weight: var(--cc-weight-micro);
    letter-spacing: var(--cc-track-micro);
    text-transform: uppercase;
  }

  .cc-yt-title {
    max-width: 100%;
    font-size: var(--cc-text-body);
    line-height: 1.4;
    color: var(--cc-ink);
    border-bottom: 1px solid transparent;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cc-yt:hover .cc-yt-title {
    color: var(--cc-accent);
    border-bottom-color: var(--cc-accent);
  }

  .cc-yt-meta {
    font-size: var(--cc-text-small);
    line-height: var(--cc-leading-small);
    color: var(--cc-ink-muted);
  }

  .cc-yt-external {
    display: inline-flex;
    align-self: center;
    padding-right: var(--cc-space-2);
    color: var(--cc-ink-faint);
  }

  .cc-yt:hover .cc-yt-external {
    color: var(--cc-accent);
  }

  /* At 390px the thumbnail is a full-width still above the text rather than
     a 128px sliver beside it. */
  @media (max-width: 519px) {
    .cc-yt {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .cc-yt-thumb {
      grid-column: 1 / -1;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cc-yt {
      transition:
        border-color var(--cc-dur-fast) var(--cc-ease),
        box-shadow var(--cc-dur-fast) var(--cc-ease);
    }
  }
</style>
