---
// The progress bar drawn on the landing level cards (`Main.dc.html`) and at
// the foot of a lesson next to "2 / 7 lessons" (`Lesson1280.dc.html`).
//
// One idiom everywhere: a count, never a percentage, and never the raw module
// id — the module is already named by the page title and the breadcrumb, so
// repeating "in m07" here only leaked an internal identifier into reader copy.
//
// Progress lives entirely in `localStorage` — there are no accounts (D020) —
// so the server renders the empty state and a hoisted script (bundled by
// Astro into an external file: CSP-clean, no inline script body) fills it in
// on load. `src/lib/progress.ts` owns the storage contract.
import { t } from '../../lib/i18n/ui.ts';
import { levelAccentStyle } from '../../lib/levels.ts';

interface Props {
  lang: string;
  /** Lesson entry ids this bar measures. */
  ids: string[];
  /** Accepted but ignored — the label is always the count form now. */
  labelMode?: 'percent' | 'count';
  /** Accepted but ignored — the module id is no longer shown in the label. */
  moduleId?: string;
  /** When set, renders a "mark as done" toggle for this lesson. */
  lessonId?: string;
  /** Tints the fill with the level colour; omit for the accent default. */
  level?: number | null;
}

const { lang, ids, lessonId, level } = Astro.props;
const strings = t(lang);

// `{done}` / `{total}` placeholders so the client script can re-render the
// label without knowing anything about the locale. EN "0 / 5 lessons",
// TR "0 / 5 ders".
const template = `{done} / {total} ${strings.lessons}`;

const initial = template.replace('{done}', '0').replace('{total}', String(ids.length));

const doneLabel = lang === 'tr' ? 'Tamamlandı olarak işaretle' : 'Mark as done';
---

<div class="cc-progress-row">
  <div
    class="cc-progress"
    data-cc-progress
    data-lang={lang}
    data-ids={JSON.stringify(ids)}
    data-label-template={template}
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax={ids.length}
    aria-valuenow="0"
    aria-valuetext={initial}
    aria-label={strings.progressNote}
  >
    <div class="cc-progress-fill" style={`width: 0%; ${levelAccentStyle(level ?? null)}`}></div>
  </div>
  <span class="cc-progress-label" data-cc-progress-label>{initial}</span>
  {
    lessonId && (
      <button
        type="button"
        class="cc-progress-toggle"
        data-cc-progress-toggle
        data-lang={lang}
        data-lesson-id={lessonId}
        aria-pressed="false"
      >
        <span data-cc-progress-toggle-label>{doneLabel}</span>
      </button>
    )
  }
</div>

<style>
  /* KILN §8.8/§4: a 6px track on the sunken paper, filled with the level hue
     (or the accent when no level is given), and a 44px pill toggle. */
  .cc-progress-row {
    display: flex;
    align-items: center;
    gap: var(--cc-space-4);
    flex-wrap: wrap;
    margin-top: var(--cc-space-6);
  }

  .cc-progress {
    flex: 1 1 140px;
    height: 6px;
    border-radius: var(--cc-radius-pill);
    background: var(--cc-paper-sunken);
    box-shadow: inset 0 0 0 1px var(--cc-line);
    overflow: hidden;
  }

  .cc-progress-fill {
    height: 100%;
    border-radius: var(--cc-radius-pill);
  }

  .cc-progress-label {
    font-size: var(--cc-text-small);
    line-height: var(--cc-leading-small);
    color: var(--cc-ink-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cc-progress-toggle {
    display: inline-flex;
    align-items: center;
    min-height: var(--cc-tap);
    padding: 0 var(--cc-space-5);
    border: 1px solid var(--cc-line);
    border-radius: var(--cc-radius-pill);
    background: var(--cc-paper-raised);
    color: var(--cc-ink-muted);
    font-family: inherit;
    font-size: var(--cc-text-small);
    cursor: pointer;
  }

  .cc-progress-toggle:hover {
    border-color: var(--cc-accent-line);
    color: var(--cc-accent);
  }

  /* Done is carried by the pressed state and the label text, never by the
     colour alone. */
  .cc-progress-toggle[aria-pressed='true'] {
    background: var(--cc-accent-wash);
    border-color: var(--cc-accent-line);
    color: var(--cc-accent);
    font-weight: 550;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cc-progress-fill {
      transition: width var(--cc-dur) var(--cc-ease);
    }

    .cc-progress-toggle {
      transition:
        background var(--cc-dur-fast) var(--cc-ease),
        border-color var(--cc-dur-fast) var(--cc-ease),
        color var(--cc-dur-fast) var(--cc-ease);
    }
  }
</style>

<script>
  import { completedCount, isComplete, toggleComplete } from '../../lib/progress.ts';

  function render(): void {
    for (const bar of document.querySelectorAll<HTMLElement>('[data-cc-progress]')) {
      let ids: string[] = [];
      try {
        const parsed: unknown = JSON.parse(bar.dataset.ids ?? '[]');
        if (Array.isArray(parsed)) ids = parsed.filter((v): v is string => typeof v === 'string');
      } catch {
        ids = [];
      }
      const lang = bar.dataset.lang ?? 'en';
      const done = completedCount(lang, ids);
      const total = ids.length;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;

      const fill = bar.querySelector<HTMLElement>('.cc-progress-fill');
      if (fill) fill.style.width = `${pct}%`;
      bar.setAttribute('aria-valuenow', String(done));

      const text = (bar.dataset.labelTemplate ?? '{done} / {total}')
        .replace('{done}', String(done))
        .replace('{total}', String(total));
      bar.setAttribute('aria-valuetext', text);

      const label = bar.parentElement?.querySelector<HTMLElement>('[data-cc-progress-label]');
      if (label) label.textContent = text;
    }
  }

  function syncToggles(): void {
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      '[data-cc-progress-toggle]',
    )) {
      const lang = button.dataset.lang ?? 'en';
      const lessonId = button.dataset.lessonId ?? '';
      const done = isComplete(lang, lessonId);
      button.setAttribute('aria-pressed', String(done));
      const label = button.querySelector<HTMLElement>('[data-cc-progress-toggle-label]');
      if (label) {
        label.textContent = done
          ? lang === 'tr'
            ? 'Tamamlandı'
            : 'Done'
          : lang === 'tr'
            ? 'Tamamlandı olarak işaretle'
            : 'Mark as done';
      }
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-cc-progress-toggle]')) {
    button.addEventListener('click', () => {
      toggleComplete(button.dataset.lang ?? 'en', button.dataset.lessonId ?? '');
      syncToggles();
      render();
    });
  }

  render();
  syncToggles();
</script>
