---
/**
 * Icon — the one icon set (KILN §6).
 *
 * No icon library: the CSP forbids external scripts, and the set has to be
 * theme-aware, so every glyph is an inline SVG path drawn here. Rules the
 * whole set obeys: 24×24 viewBox, 1.75 stroke, round caps and joins,
 * `stroke="currentColor"`, `fill="none"` unless the glyph is intrinsically
 * solid (`github`, and the dot of `rss`), and optically balanced at 20 px —
 * which is why most glyphs live inside a ~17-unit optical square rather
 * than filling the viewBox.
 *
 * Accessibility: decorative by default (`aria-hidden="true"`, no focus). An
 * icon that is the only content of a control should stay decorative and let
 * the control carry the name (`aria-label` on the button); pass `label` only
 * when the icon itself is the content, which turns it into `role="img"`
 * with an `aria-label`.
 *
 * PATH DATA IS WRITTEN LONG-HAND ON PURPOSE: every number space-separated,
 * every decimal carrying its leading zero. SVG's shorthand form drops the
 * separator between consecutive decimals, and four such numbers in a row
 * are indistinguishable from a dotted-quad IP address —
 * `scripts/check-public-hygiene.mjs` and the pre-commit hook both refuse
 * the file when one appears. Long-hand draws the same path and can never
 * trip that rule.
 *
 * @example
 *   <Icon name="search" />
 *   <button aria-label={t.search}><Icon name="search" /></button>
 *   <Icon name="check-circle" label="Verified" size={16} />
 */

interface Glyph {
  /** Paths drawn with the shared stroke settings. */
  stroke?: readonly string[];
  /** Paths drawn as solid fills (logos, dots). */
  fill?: readonly string[];
}

