export type IconName = keyof typeof GLYPHS;

interface Props {
  name: IconName;
  /** Rendered box in px. The set is drawn to read at 20; 16–28 all hold. */
  size?: number | string;
  /**
   * Accessible name. Omit for a decorative icon (the default) — including an
   * icon-only control, where the name belongs on the control itself.
   */
  label?: string;
  /** Alias for `label`, for callers that think in terms of a `<title>`. */
  title?: string;
  class?: string;
}

const { name, size = 20, label, title, class: className } = Astro.props;

const glyph: Glyph = GLYPHS[name];
if (!glyph) throw new Error(`Icon: unknown name "${name}"`);

const accessibleName = label ?? title;
---

<svg
  class:list={['cc-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={accessibleName ? 'img' : undefined}
  aria-label={accessibleName}
  aria-hidden={accessibleName ? undefined : 'true'}
  focusable="false"
  >{(glyph.stroke ?? []).map((d) => <path d={d} />)}{
    (glyph.fill ?? []).map((d) => <path d={d} fill="currentColor" stroke="none" />)
  }</svg
>

<style>
  .cc-icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.15em;
  }
</style>
