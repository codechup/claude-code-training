---
// Swaps the first path segment between "en" and "tr" and remembers the
// choice in a `cc_lang` cookie (1 year, SameSite=Lax) that the origin's `/`
// redirect honours over Accept-Language (D017; nginx side lives in
// docs/deploy, not in this repo — src/pages/index.astro is the static
// fallback for the same rule).
//
// Draft handling (plans/P06 Scope): whether the target-language page exists
// as a live page is decided at BUILD time by the page that renders this
// component (it holds the collections and therefore the set of `draft: true`
// ids). When `targetPath` is null the switch renders as static text —
// "Türkçesi hazırlanıyor" when the missing page is Turkish, "English version
// coming" the other way around — instead of a link into a 404.
import { draftNotice, otherLang, t } from '../../lib/i18n/ui.ts';

interface Props {
  currentLang: string;
  /** Absolute path of the sibling-language page, or null when it is a draft. */
  targetPath?: string | null;
}

const { currentLang, targetPath } = Astro.props;
const target = otherLang(currentLang);
const strings = t(currentLang);
const label = target === 'en' ? 'EN' : 'TR';
const current = currentLang === 'en' ? 'EN' : 'TR';
const available = typeof targetPath === 'string' && targetPath.length > 0;
---

{
  available ? (
    <a
      id="cc-lang-switch"
      href={targetPath}
      hreflang={target}
      lang={target}
      data-target-lang={target}
      class="cc-lang"
      aria-label={`${strings.language}: ${label}`}
    >
      <span class="mono" aria-hidden="true">
        {current}
      </span>
      <span class="muted" aria-hidden="true">
        /
      </span>
      <span class="mono muted" aria-hidden="true">
        {label}
      </span>
    </a>
  ) : (
    <span
      id="cc-lang-switch-draft"
      class="cc-lang cc-lang-draft mono"
      lang={target}
      data-target-lang={target}
      data-draft="true"
    >
      {draftNotice(target)}
    </span>
  )
}

<style>
  .cc-lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap-target);
    padding: 0 10px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-2);
    font-size: var(--text-13);
    text-decoration: none;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .cc-lang-draft {
    color: var(--color-ink-muted);
    font-size: var(--text-12);
    border-style: dashed;
    max-width: 12rem;
  }

  @media (min-width: 640px) {
    .cc-lang {
      min-height: 36px;
    }
  }
</style>

<script>
  // Remember the reader's language choice so the origin redirect at `/`
  // (and src/pages/index.astro's JS fallback) can honour it next time.
  // Hoisted — Astro bundles this into an external module, so no inline
  // script body reaches the page (CSP: script-src 'self').
  const link = document.getElementById('cc-lang-switch');
  link?.addEventListener('click', () => {
    const target = link.dataset.targetLang;
    if (!target) return;
    try {
      document.cookie = `cc_lang=${target}; path=/; max-age=${60 * 60 * 24 * 365}; SameSite=Lax`;
    } catch {
      // Cookie writes can fail under strict privacy settings — the link's
      // navigation still works without the preference being saved.
    }
  });
</script>
