---
// Site footer, per `docs/design/canvas-out/Main.dc.html` (mono lockup left,
// "MIT · verified on Claude Code <version> · edit on GitHub" right) and
// `Landing390.dc.html` (stacked on phone).
import { t } from '../../lib/i18n/ui.ts';
import { VERIFIED_VERSION } from '../../lib/changes.ts';
import { REPO_URL } from '../../lib/repo.ts';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const strings = t(lang);

const SIGIL_CELLS: [number, number][] = [
  [1, 1],
  [9, 1],
  [1, 9],
  [9, 9],
  [17, 9],
  [1, 17],
  [9, 17],
  [17, 17],
];
---

<footer class="cc-footer">
  <div class="cc-footer-brand">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      aria-hidden="true"
      focusable="false"
    >
      <g fill="currentColor">
        {SIGIL_CELLS.map(([x, y]) => <rect x={x} y={y} width="6" height="6" rx="1" />)}
      </g>
      <rect x="17" y="1" width="6" height="6" rx="1" fill="var(--color-accent)"></rect>
    </svg>
    <span class="mono">codechup · {strings.brandAcademy}</span>
  </div>
  <p class="mono cc-footer-meta">
    <span>MIT</span>
    <span aria-hidden="true">·</span>
    <span>{strings.verifiedOn} Claude Code {VERIFIED_VERSION}</span>
    <span aria-hidden="true">·</span>
    <a href={REPO_URL}>GitHub</a>
  </p>
</footer>

<style>
  .cc-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-muted);
  }

  .cc-footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-11);
  }

  .cc-footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    max-width: none;
    font-size: var(--text-12);
  }

  .cc-footer-meta a {
    color: var(--color-accent-text);
  }

  @media (min-width: 1024px) {
    .cc-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-6) var(--space-16);
    }
  }
</style>
