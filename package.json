{
  "name": "claude-code-training",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/content-gate.ts",
    "build": "astro build",
    "postbuild": "pagefind --site dist --root-selector \"main#main\" && node scripts/check-no-inline-script.mjs --dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . && prettier --check . && node scripts/check-no-inline-script.mjs && node scripts/check-public-hygiene.mjs && node scripts/check-raw-colors.mjs",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "plan": "node tools/plan/cli.ts",
    "gate": "node scripts/content-gate.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "gray-matter": "4.0.3",
    "pagefind": "1.5.2",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.0",
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@types/hast": "^3.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "fast-xml-parser": "5.11.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "satteri": "^0.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
